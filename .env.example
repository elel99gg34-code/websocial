# ─────────────────────────────────────────────────────────────
# 유료(고품질) — Claude. 집필 품질이 가장 중요한 단계에 사용.
# https://console.anthropic.com/ 에서 발급
# ─────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=

# ─────────────────────────────────────────────────────────────
# 무료 티어 제공자 — 아래 중 하나만 있어도 전 파이프라인이 돌아간다.
# 무료 한도·모델명은 각 제공자 정책에 따라 바뀌므로 실제 값은 공식 문서 확인.
# `npm run novel -- providers` 로 현재 감지 상태를 볼 수 있다.
# ─────────────────────────────────────────────────────────────

# Google Gemini (AI Studio 무료 티어) — https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Groq (무료 티어, 매우 빠름) — https://console.groq.com/keys
GROQ_API_KEY=

# OpenRouter (`:free` 접미사 모델 무료) — https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Cerebras (무료 티어) — https://cloud.cerebras.ai/
CEREBRAS_API_KEY=

# xAI Grok (유료) — https://console.x.ai/
XAI_API_KEY=

# Mistral (무료 티어) — https://console.mistral.ai/
MISTRAL_API_KEY=

# DeepSeek — https://platform.deepseek.com/
DEEPSEEK_API_KEY=

# Ollama / LM Studio 는 로컬 실행이라 키가 필요 없다 (완전 무료).
#   ollama serve && ollama pull qwen2.5:14b
